<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title><%= title %> | ApexTech Store</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

  <!-- Wishlist JavaScript -->
  <script src="/js/wishlist.js?v=2" defer></script>

  <!-- Custom CSS -->
  <link href="/css/style.css" rel="stylesheet">
</head>

<body>

  <!-- Top Announcement Bar (Amazon/Apple Style) -->
  <aside class="top-announcement-bar d-none d-md-block" aria-label="Store announcement">
    <div class="container d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center gap-3">
        <span><i class="bi bi-lightning-charge-fill text-warning me-1"></i> <strong>FREE Express Delivery</strong> on orders over &#8377;999</span>
        <span class="text-secondary">|</span>
        <span><i class="bi bi-shield-check text-info me-1"></i> 100% Genuine Certified Tech & Apple Products</span>
      </div>
      <div class="d-flex align-items-center gap-3 small">
        <a href="#products"><i class="bi bi-tag-fill me-1"></i> Today's Deals</a>
        <span>•</span>
        <a href="/orders"><i class="bi bi-truck me-1"></i> Track Order</a>
        <span>•</span>
        <span class="text-light"><i class="bi bi-telephone me-1"></i> 24/7 Support: 1800-APEX-TECH</span>
      </div>
    </div>
  </aside>

  <header>
    <nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top py-2 py-lg-3 shadow-sm" aria-label="Main navigation">
      <div class="container">

        <!-- Website logo -->
        <a class="navbar-brand me-3" href="/">
          <i class="bi bi-apple text-dark fs-4"></i>
          <span>Shopify</span>
          <span class="brand-dot"></span>
          <span class="brand-tagline">Prime</span>
        </a>

        <!-- Mobile menu button -->
        <button
          class="navbar-toggler border-0 shadow-none"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#mainNavbar"
          aria-controls="mainNavbar"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">

          <!-- Search bar (Amazon style) -->
          <form
            class="d-flex flex-grow-1 mx-lg-4 my-3 my-lg-0"
            action="/"
            method="GET"
            role="search"
          >
            <label class="visually-hidden" for="siteSearch">Search products</label>
            <div class="search-input-wrapper">
              <i class="bi bi-search search-icon-inside" aria-hidden="true"></i>
              <input
                class="form-control search-field"
                id="siteSearch"
                type="search"
                name="search"
                placeholder="Search iPhone, MacBook, AirPods, smartwatches, accessories..."
                value="<%= typeof query !== 'undefined' && query.search ? query.search : '' %>"
              >
              <button
                class="btn btn-primary search-submit-btn"
                type="submit"
                aria-label="Search"
              >
                Search
              </button>
            </div>
          </form>

          <ul class="navbar-nav align-items-lg-center gap-1 gap-lg-2">

            <!-- Wishlist icon and count -->
            <li class="nav-item">
              <a
                class="nav-action-btn position-relative"
                href="/wishlist"
                aria-label="Wishlist"
              >
                <i class="bi bi-heart-fill text-danger fs-5" aria-hidden="true"></i>
                <span class="d-lg-none ms-1">Wishlist</span>

                <!-- Wishlist count -->
                <span
                  id="wishlist-count"
                  class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger <%= wishlistCount > 0 ? '' : 'd-none' %>"
                >
                  <%= wishlistCount %>
                  <span class="visually-hidden">items in wishlist</span>
                </span>
              </a>
            </li>

            <!-- Cart icon and count -->
            <li class="nav-item">
              <a
                class="nav-action-btn position-relative"
                href="/cart"
                aria-label="Cart"
              >
                <i class="bi bi-cart3 text-primary fs-5" aria-hidden="true"></i>
                <span class="d-none d-xl-inline fw-semibold text-dark ms-1">Cart</span>

                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary">
                  <%= cartCount %>
                  <span class="visually-hidden">items in cart</span>
                </span>
              </a>
            </li>

            <!-- Divider on desktop -->
            <li class="nav-item d-none d-lg-block border-start ps-2 my-1" style="height: 1.5rem; opacity: 0.3;"></li>

            <!-- Logged-in user -->
            <% if (user) { %>
              <li class="nav-item dropdown">
                <a
                  class="nav-action-btn dropdown-toggle"
                  href="#"
                  id="accountMenu"
                  role="button"
                  data-bs-toggle="dropdown"
                  aria-expanded="false"
                >
                  <span class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center fw-bold me-1" style="width: 28px; height: 28px; font-size: 0.8rem;">
                    <%= user.name.charAt(0).toUpperCase() %>
                  </span>
                  <span class="fw-semibold"><%= user.name.split(' ')[0] %></span>
                </a>

                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 mt-2" aria-labelledby="accountMenu">
                  <li class="px-3 py-2 border-bottom">
                    <p class="mb-0 small fw-bold text-dark"><%= user.name %></p>
                    <p class="mb-0 text-muted small text-truncate" style="max-width: 180px;"><%= user.email %></p>
                  </li>
                  <li><a class="dropdown-item py-2" href="/profile"><i class="bi bi-person me-2 text-primary"></i>My Profile</a></li>
                  <li><a class="dropdown-item py-2" href="/orders"><i class="bi bi-bag-check me-2 text-primary"></i>My Orders</a></li>
                  <li><a class="dropdown-item py-2" href="/addresses"><i class="bi bi-geo-alt me-2 text-primary"></i>Saved Addresses</a></li>
                  <li><a class="dropdown-item py-2" href="/wishlist"><i class="bi bi-heart me-2 text-danger"></i>Wishlist</a></li>

                  <% if (user.role === 'admin') { %>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item py-2 text-primary fw-semibold" href="/admin/dashboard"><i class="bi bi-speedometer2 me-2"></i>Admin Dashboard</a></li>
                  <% } %>

                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <form action="/logout" method="POST" class="px-2 py-1">
                      <button class="btn btn-sm btn-outline-danger w-100 d-flex align-items-center justify-content-center gap-2" type="submit">
                        <i class="bi bi-box-arrow-right"></i> Logout
                      </button>
                    </form>
                  </li>
                </ul>
              </li>
            <% } else { %>
              <!-- Guest user -->
              <li class="nav-item ms-lg-2">
                <a class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1" href="/login">
                  <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                </a>
              </li>
              <li class="nav-item">
                <a class="btn btn-primary btn-sm rounded-pill px-3 py-1 text-white" href="/register">
                  Register
                </a>
              </li>
            <% } %>

          </ul>
        </div>
      </div>
    </nav>

    <!-- Category Subnav Strip (Amazon / Apple Style) -->
    <nav class="category-subnav d-none d-md-block" aria-label="Category quick navigation">
      <div class="container d-flex align-items-center gap-2">
        <a class="category-nav-link fw-bold text-dark" href="/#products">
          <i class="bi bi-grid-fill text-primary"></i> All Categories
        </a>
        <a class="category-nav-link" href="/?search=iPhone">
          <i class="bi bi-phone"></i> iPhones & Smartphones
        </a>
        <a class="category-nav-link" href="/?search=Laptop">
          <i class="bi bi-laptop"></i> Mac & Laptops
        </a>
        <a class="category-nav-link" href="/?search=iPad">
          <i class="bi bi-tablet"></i> iPads & Tablets
        </a>
        
        <a class="category-nav-link" href="/?search=Watch">
          <i class="bi bi-smartwatch"></i> Apple Watch & Wearables
        </a>
        <a class="category-nav-link" href="/?search=AirPods">
          <i class="bi bi-headphones"></i> Audio & AirPods
        </a>
        <a class="category-nav-link" href="/?search=MagSafe">
          <i class="bi bi-plug"></i> Accessories & Power
        </a>
        <div class="ms-auto">
          <a class="category-nav-link text-danger fw-bold" href="/#products">
            <i class="bi bi-fire text-danger"></i> Mega Deals & Discounts
          </a>
        </div>
      </div>
    </nav>
  </header>

  <main>
    <!-- Wishlist AJAX message toast -->
    <div class="container mt-3">
      <div
        id="wishlist-message"
        class="alert alert-success alert-dismissible fade show d-none shadow-sm rounded-3"
        role="alert"
        aria-live="polite"
      >
        <span id="wishlist-message-text"></span>
        <button
          type="button"
          class="btn-close"
          aria-label="Close"
          onclick="this.parentElement.classList.add('d-none')"
        ></button>
      </div>
    </div>






