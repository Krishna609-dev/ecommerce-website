  <!-- Related products section -->
  <% if (relatedProducts.length) { %>
    <section class="mt-5 pt-4 border-top" aria-labelledby="relatedProductsTitle">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
          <h2 class="h4 fw-bold mb-1" id="relatedProductsTitle">Customers Also Viewed</h2>
          <p class="text-secondary small mb-0">Similar top-rated items in <%= categoryName %>.</p>
        </div>
        <a href="/?category=<%= product.category ? encodeURIComponent(String(product.category._id || '')) : '' %>" class="btn btn-outline-primary btn-sm rounded-pill">
          View all in category
        </a>
      </div>

      <div class="row g-3 g-md-4">
        <% relatedProducts.slice(0, 4).forEach(function (relatedProduct, idx) {
          var relatedId = String(relatedProduct._id);
          var relatedImage = getImgUrl(relatedProduct.images && relatedProduct.images.length > 0 ? relatedProduct.images[0] : null);
          var relDiscount = 15;
          var relOriginal = Math.round(relatedProduct.price * (1 + relDiscount / 100));
        %>
          <div class="col-6 col-md-4 col-xl-3">
            <article class="product-card h-100">
              <div class="product-media-wrapper">
                <span class="badge-discount">-<%= relDiscount %>% OFF</span>
                <a href="/products/<%= encodeURIComponent(relatedId) %>" class="d-block w-100 h-100 text-center" aria-label="View <%= relatedProduct.name %> details">
                  <img class="product-card-img" src="<%= relatedImage %>" alt="<%= relatedProduct.name %>" loading="lazy">
                </a>
              </div>
              <div class="card-product-content">
                <div class="product-category-name"><%= categoryName %></div>
                <a href="/products/<%= encodeURIComponent(relatedId) %>" class="product-title-text" title="<%= relatedProduct.name %>">
                  <%= relatedProduct.name %>
                </a>
                <div class="rating-stars-wrap">
                  <span class="stars-gold"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i></span>
                  <span class="fw-bold small text-dark ms-1">4.9</span>
                </div>
                <div class="product-pricing-box">
                  <span class="current-price">&#8377;<%= Number(relatedProduct.price).toLocaleString('en-IN') %></span>
                  <span class="original-mrp">&#8377;<%= Number(relOriginal).toLocaleString('en-IN') %></span>
                </div>
                <div class="prime-tag">
                  <i class="bi bi-lightning-charge-fill text-warning"></i>
                  <span>FREE Delivery</span>
                </div>
                <div class="product-actions-row">
                  <% if (relatedProduct.stock === 0) { %>
                    <button class="btn btn-secondary btn-sm" type="button" disabled>Out of stock</button>
                  <% } else { %>
                    <form action="/cart/add" method="POST" class="m-0">
                      <input type="hidden" name="productId" value="<%= relatedId %>">
                      <input type="hidden" name="quantity" value="1">
                      <button class="btn btn-add-cart w-100" type="submit">
                        <i class="bi bi-cart-plus"></i> Add
                      </button>
                    </form>
                  <% } %>
                  <a class="btn-view-quick" href="/products/<%= encodeURIComponent(relatedId) %>" title="View details">
                    <i class="bi bi-arrow-right"></i>
                  </a>
                </div>
              </div>
            </article>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>

</section>

<script>
  document.querySelectorAll('.detail-thumb-btn').forEach(function (button) {
    button.addEventListener('click', function () {
      var mainImage = document.getElementById('productMainImage');
      var imageSrc = button.dataset.imageSrc;

      if (!mainImage || !imageSrc) return;

      mainImage.src = imageSrc;
      mainImage.alt = button.dataset.imageAlt || mainImage.alt;

      document.querySelectorAll('.detail-thumb-btn').forEach(function (thumbnail) {
        var isActive = thumbnail === button;
        thumbnail.classList.toggle('active', isActive);

        if (isActive) {
          thumbnail.setAttribute('aria-current', 'true');
        } else {
          thumbnail.removeAttribute('aria-current');
        }
      });
    });
  });

  // Confirm handler for remove forms
  document.querySelectorAll('form[data-confirm]').forEach(function (form) {
    form.addEventListener('submit', function (event) {
      if (!window.confirm(form.dataset.confirm)) {
        event.preventDefault();
      }
    });
  });
</script>

