<!-- <%- include('../partials/header', { title: title, user: user, cartCount: cartCount }) %>
<%- include('../partials/flash') %>

<section class="container py-4 py-md-5">
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
      <h1 class="h2 fw-bold mb-1">Your cart</h1>
      <p class="text-secondary mb-0"><%= cartCount %> item(s)</p>
    </div>
    <% if (items.length) { %>
      <form action="/cart/clear" method="POST">
        <button class="btn btn-outline-danger" type="submit">Clear cart</button>
      </form>
    <% } %>
  </div>

  <% if (items.length) { %>
    <div class="row g-4 align-items-start">
      <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
          <div class="list-group list-group-flush rounded-4">
            <% items.forEach(function(item) {
              var product = item.product;
              var available = product && product.isActive && product.stock >= item.quantity;
              var image = product && product.images && product.images.length
                ? '/uploads/' + encodeURIComponent(product.images[0])
                : null;
            %>
              <article class="list-group-item p-3 p-md-4">
                <div class="row g-3 align-items-center">
                  <div class="col-4 col-sm-3">
                    <% if (image) { %>
                      <img class="img-fluid rounded-3" src="<%= image %>" alt="<%= product.name %>" loading="lazy">
                    <% } else { %>
                      <div class="bg-light rounded-3 d-flex align-items-center justify-content-center text-secondary text-center p-3" style="aspect-ratio: 1 / 1;">
                        <span class="small"><%= product ? 'No image' : 'Unavailable' %></span>
                      </div>
                    <% } %>
                  </div>
                  <div class="col-8 col-sm-9">
                    <div class="d-flex flex-column flex-md-row justify-content-between gap-3">
                      <div>
                        <h2 class="h5 fw-semibold mb-1"><%= product ? product.name : 'Product unavailable' %></h2>
                        <% if (product) { %>
                          <p class="text-secondary mb-2">&#8377;<%= Number(product.price).toFixed(2) %> each</p>
                          <% if (!available) { %>
                            <p class="small text-danger mb-0">
                              <%= product.isActive ? `Only ${product.stock} available; update the quantity.` : 'This product is no longer available.' %>
                            </p>
                          <% } %>
                        <% } %>
                      </div>
                      <div class="text-md-end">
                        <% if (product) { %>
                          <p class="fw-bold mb-2">&#8377;<%= (Number(product.price) * item.quantity).toFixed(2) %></p>
                        <% } %>
                        <div class="d-flex flex-wrap gap-2">
                          <% if (product && product.isActive && product.stock > 0) { %>
                            <form action="/cart/items/<%= encodeURIComponent(String(product._id)) %>" method="POST" class="d-flex gap-2">
                              <label class="visually-hidden" for="quantity-<%= String(product._id) %>">Quantity for <%= product.name %></label>
                              <input class="form-control form-control-sm" id="quantity-<%= String(product._id) %>" name="quantity" type="number" min="1" max="<%= product.stock %>" value="<%= item.quantity %>" required style="width: 5.5rem;">
                              <button class="btn btn-sm btn-outline-primary" type="submit">Update</button>
                            </form>
                          <% } %>
                          <form action="/cart/remove/<%= encodeURIComponent(String(item._id)) %>" method="POST">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Remove</button>
                          </form>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        </div>
      </div>

      <div class="col-12 col-lg-4">
        <section class="card border-0 shadow-sm rounded-4">
          <div class="card-body p-3 p-md-4">
            <h2 class="h5 fw-bold mb-3">Order summary</h2>
            <div class="d-flex justify-content-between mb-3">
              <span class="text-secondary">Subtotal</span>
              <strong>&#8377;<%= Number(subtotal).toFixed(2) %></strong>
            </div>
            <p class="small text-secondary mb-3">Shipping and taxes are calculated at checkout.</p>
            <% if (items.some(function(item) { return !item.product || !item.product.isActive || item.product.stock < item.quantity; })) { %>
              <button class="btn btn-primary w-100" type="button" disabled>Resolve unavailable items</button>
            <% } else { %>
              <button class="btn btn-primary w-100" type="button" disabled>Checkout coming soon</button>
            <% } %>
            <a class="btn btn-outline-primary w-100 mt-2" href="/">Continue shopping</a>
          </div>
        </section>
      </div>
    </div>
  <% } else { %>
    <div class="card border-0 shadow-sm rounded-4 text-center">
      <div class="card-body p-4 p-md-5">
        <i class="bi bi-cart3 display-4 text-secondary" aria-hidden="true"></i>
        <h2 class="h4 fw-semibold mt-3">Your cart is empty</h2>
        <p class="text-secondary">Browse the store and add something you like.</p>
        <a class="btn btn-primary" href="/">Continue shopping</a>
      </div>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %> -->
