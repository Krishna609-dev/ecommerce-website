<%- include('../partials/header', { title: 'My profile' }) %>
<%- include('../partials/flash') %>

<section class="container py-4 py-md-5">
  <div class="mb-4">
    <h1 class="h2 fw-bold mb-1">My profile</h1>
    <p class="text-secondary mb-0">Manage your account details and preferences.</p>
  </div>

  <div class="row g-4">
    <div class="col-12 col-lg-5">
      <section class="card h-100 border-0 shadow-sm rounded-4" aria-labelledby="profileCardTitle">
        <div class="card-body p-4 p-md-5">
          <div class="d-flex align-items-center gap-3 mb-4">
            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold fs-3"
                 style="width: 4.5rem; height: 4.5rem;"
                 aria-hidden="true"><%= profileUser.name.charAt(0).toUpperCase() %></div>
            <div>
              <h2 class="h4 fw-bold mb-1" id="profileCardTitle"><%= profileUser.name %></h2>
              <p class="text-secondary mb-0"><%= profileUser.email %></p>
            </div>
          </div>

          <dl class="row mb-4">
            <dt class="col-sm-5 text-secondary fw-normal">Phone</dt>
            <dd class="col-sm-7"><%= profileUser.phone || 'Not provided' %></dd>

            <dt class="col-sm-5 text-secondary fw-normal">Member since</dt>
            <dd class="col-sm-7"><%= new Date(profileUser.createdAt).toLocaleDateString() %></dd>
          </dl>

          <a class="btn btn-primary" href="/profile/edit">
            <i class="bi bi-pencil me-1" aria-hidden="true"></i>Edit profile
          </a>
        </div>
      </section>
    </div>

    <div class="col-12 col-lg-7">
      <h2 class="h4 fw-bold mb-3">Quick links</h2>
      <div class="row g-3">
        <div class="col-12 col-md-4">
          <a class="card h-100 border-0 shadow-sm rounded-4 text-decoration-none text-body" href="/orders">
            <div class="card-body p-4">
              <i class="bi bi-receipt fs-3 text-primary" aria-hidden="true"></i>
              <h3 class="h6 fw-semibold mt-3 mb-0">My Orders</h3>
            </div>
          </a>
        </div>
        <div class="col-12 col-md-4">
          <a class="card h-100 border-0 shadow-sm rounded-4 text-decoration-none text-body" href="/addresses">
            <div class="card-body p-4">
              <i class="bi bi-geo-alt fs-3 text-primary" aria-hidden="true"></i>
              <h3 class="h6 fw-semibold mt-3 mb-0">Addresses</h3>
            </div>
          </a>
        </div>
        <div class="col-12 col-md-4">
          <a class="card h-100 border-0 shadow-sm rounded-4 text-decoration-none text-body" href="/wishlist">
            <div class="card-body p-4">
              <i class="bi bi-heart fs-3 text-primary" aria-hidden="true"></i>
              <h3 class="h6 fw-semibold mt-3 mb-0">Wishlist</h3>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
