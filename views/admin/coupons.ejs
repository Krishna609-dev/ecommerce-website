<%- include('partials/admin-header', { title: 'Coupons', activePage: 'coupons' }) %>

<div class="admin-page-header">
  <div>
    <h2 class="h3 fw-bold">Coupons</h2>
    <p class="text-secondary mb-0">Manage discounts available to your customers.</p>
  </div>
  <a class="btn btn-primary" href="/admin/coupons/new">
    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add coupon
  </a>
</div>

<section class="card" aria-labelledby="couponListTitle">
  <div class="card-body p-0">
    <h3 class="visually-hidden" id="couponListTitle">Coupon list</h3>
    <% if (coupons.length) { %>
      <div class="table-responsive">
        <table class="table table-striped table-hover small mb-0">
          <thead>
            <tr>
              <th scope="col">Code</th>
              <th scope="col">Discount</th>
              <th scope="col">Min order</th>
              <th scope="col">Max discount</th>
              <th scope="col">Expiry date</th>
              <th scope="col">Status</th>
              <th scope="col" class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% coupons.forEach(function(coupon) {
              var couponId = String(coupon._id);
              var hasExpired = new Date(coupon.expiryDate).getTime() < Date.now();
              var statusLabel = hasExpired ? 'Expired' : (coupon.isActive ? 'Active' : 'Inactive');
              var statusClass = hasExpired ? 'bg-danger' : (coupon.isActive ? 'bg-success' : 'bg-secondary');
            %>
              <tr>
                <td><span class="badge bg-light text-dark border font-monospace"><%= coupon.code %></span></td>
                <td>
                  <% if (coupon.discountType === 'percentage') { %>
                    <%= Number(coupon.discountValue) %>%
                  <% } else { %>
                    &#8377;<%= Number(coupon.discountValue).toFixed(2) %>
                  <% } %>
                </td>
                <td class="text-nowrap">&#8377;<%= Number(coupon.minOrderAmount).toFixed(2) %></td>
                <td class="text-nowrap">
                  <% if (coupon.maxDiscount !== null && coupon.maxDiscount !== undefined && coupon.maxDiscount !== '') { %>
                    &#8377;<%= Number(coupon.maxDiscount).toFixed(2) %>
                  <% } else { %>
                    &mdash;
                  <% } %>
                </td>
                <td><%= new Date(coupon.expiryDate).toLocaleDateString() %></td>
                <td><span class="badge <%= statusClass %>"><%= statusLabel %></span></td>
                <td>
                  <div class="d-flex justify-content-end gap-2">
                    <a class="btn btn-sm btn-outline-primary" href="/admin/coupons/<%= encodeURIComponent(couponId) %>/edit">Edit</a>
                    <form
                      action="/admin/coupons/<%= encodeURIComponent(couponId) %>/toggle"
                      method="POST"
                      <%= coupon.isActive ? 'data-confirm="Deactivate this coupon?"' : '' %>>
                      <% if (coupon.isActive) { %>
                        <button class="btn btn-sm btn-outline-danger" type="submit">Deactivate</button>
                      <% } else { %>
                        <button class="btn btn-sm btn-outline-success" type="submit">Activate</button>
                      <% } %>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="text-center px-4 py-5">
        <i class="bi bi-ticket-perforated display-4 text-secondary" aria-hidden="true"></i>
        <h3 class="h5 fw-semibold mt-3">No coupons yet</h3>
        <p class="text-secondary mb-4">Create a coupon to offer a discount to your customers.</p>
        <a class="btn btn-primary" href="/admin/coupons/new">Add coupon</a>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/admin-footer') %>
