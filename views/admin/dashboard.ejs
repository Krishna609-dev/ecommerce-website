
<%- include('partials/admin-header', { title: 'Dashboard', activePage: 'dashboard' }) %>

<%
  // Orders by status
  var statusRows = [
    { name: 'Pending', count: ordersByStatus.Pending, badge: 'bg-warning text-dark', bar: 'bg-warning' },
    { name: 'Processing', count: ordersByStatus.Processing, badge: 'bg-info text-dark', bar: 'bg-info' },
    { name: 'Shipped', count: ordersByStatus.Shipped, badge: 'bg-primary', bar: 'bg-primary' },
    { name: 'Delivered', count: ordersByStatus.Delivered, badge: 'bg-success', bar: 'bg-success' },
    { name: 'Cancelled', count: ordersByStatus.Cancelled, badge: 'bg-danger', bar: 'bg-danger' },
    { name: 'Payment Failed', count: ordersByStatus['Payment Failed'], badge: 'bg-secondary', bar: 'bg-secondary' }
  ];

  // Order status badge classes
  var orderStatusClasses = {
    'Pending': 'bg-warning text-dark',
    'Processing': 'bg-info text-dark',
    'Shipped': 'bg-primary',
    'Delivered': 'bg-success',
    'Cancelled': 'bg-danger',
    'Payment Failed': 'bg-secondary'
  };
%>

<!-- Dashboard Header -->
<div class="admin-page-header">
  <div>
    <h2 class="h3 fw-bold">Dashboard</h2>
    <p class="text-secondary mb-0">
      Here's an overview of your store.
    </p>
  </div>
</div>


<!-- Summary Cards -->
<section class="row g-3 g-xl-4 mb-4" aria-label="Store statistics">

  <!-- Total Users -->
  <div class="col-12 col-sm-6 col-xl-3">
    <article class="card h-100">
      <div class="card-body d-flex align-items-center gap-3 p-3 p-xl-4">

        <span class="d-inline-flex align-items-center justify-content-center rounded-3 bg-primary-subtle text-primary fs-4"
              style="width: 3rem; height: 3rem;">
          <i class="bi bi-people" aria-hidden="true"></i>
        </span>

        <div>
          <p class="small text-secondary mb-1">Total Users</p>
          <p class="h3 fw-bold mb-0">
            <%= Number(stats.totalUsers).toLocaleString('en-IN') %>
          </p>
        </div>

      </div>
    </article>
  </div>


  <!-- Total Products -->
  <div class="col-12 col-sm-6 col-xl-3">
    <article class="card h-100">
      <div class="card-body d-flex align-items-center gap-3 p-3 p-xl-4">

        <span class="d-inline-flex align-items-center justify-content-center rounded-3 bg-info-subtle text-info fs-4"
              style="width: 3rem; height: 3rem;">
          <i class="bi bi-box-seam" aria-hidden="true"></i>
        </span>

        <div>
          <p class="small text-secondary mb-1">Total Products</p>
          <p class="h3 fw-bold mb-0">
            <%= Number(stats.totalProducts).toLocaleString('en-IN') %>
          </p>
        </div>

      </div>
    </article>
  </div>


  <!-- Total Orders -->
  <div class="col-12 col-sm-6 col-xl-3">
    <article class="card h-100">
      <div class="card-body d-flex align-items-center gap-3 p-3 p-xl-4">

        <span class="d-inline-flex align-items-center justify-content-center rounded-3 bg-warning-subtle text-warning fs-4"
              style="width: 3rem; height: 3rem;">
          <i class="bi bi-receipt" aria-hidden="true"></i>
        </span>

        <div>
          <p class="small text-secondary mb-1">Total Orders</p>
          <p class="h3 fw-bold mb-0">
            <%= Number(stats.totalOrders).toLocaleString('en-IN') %>
          </p>
        </div>

      </div>
    </article>
  </div>


  <!-- Total Sales -->
  <div class="col-12 col-sm-6 col-xl-3">
    <article class="card h-100">
      <div class="card-body d-flex align-items-center gap-3 p-3 p-xl-4">

        <span class="d-inline-flex align-items-center justify-content-center rounded-3 bg-success-subtle text-success fs-4"
              style="width: 3rem; height: 3rem;">
          <i class="bi bi-currency-rupee" aria-hidden="true"></i>
        </span>

        <div>
          <p class="small text-secondary mb-1">Total Sales</p>
          <p class="h4 fw-bold mb-0">
            &#8377;<%= Number(stats.totalSales).toLocaleString('en-IN', {
              minimumFractionDigits: 2,
              maximumFractionDigits: 2
            }) %>
          </p>
        </div>

      </div>
    </article>
  </div>

</section>


<!-- Orders by Status and Low Stock -->
<div class="row g-3 g-xl-4 mb-4">

  <!-- Orders by Status -->
  <div class="col-12 col-xl-5">
    <section class="card h-100" aria-labelledby="ordersByStatusTitle">

      <div class="card-body p-3 p-md-4">

        <h2 class="h5 fw-semibold mb-4" id="ordersByStatusTitle">
          Orders by Status
        </h2>

        <div class="d-grid gap-4">

          <% statusRows.forEach(function(row) {

            var share = Number(stats.totalOrders) > 0
              ? Math.min(100, (Number(row.count) / Number(stats.totalOrders)) * 100)
              : 0;

          %>

            <div>

              <div class="d-flex justify-content-between align-items-center mb-2">

                <span class="badge <%= row.badge %>">
                  <%= row.name %>
                </span>

                <span class="small fw-semibold">
                  <%= Number(row.count).toLocaleString('en-IN') %>
                </span>

              </div>

              <div class="progress"
                   role="progressbar"
                   aria-label="<%= row.name %> orders"
                   aria-valuenow="<%= share %>"
                   aria-valuemin="0"
                   aria-valuemax="100"
                   style="height: .5rem;">

                <div class="progress-bar <%= row.bar %>"
                     style="width: <%= share %>%">
                </div>

              </div>

            </div>

          <% }) %>

        </div>

      </div>
    </section>
  </div>


  <!-- Low Stock Products -->
  <div class="col-12 col-xl-7">
    <section class="card h-100" aria-labelledby="lowStockTitle">

      <div class="card-body p-3 p-md-4">

        <div class="d-flex justify-content-between align-items-center gap-3 mb-3">

          <h2 class="h5 fw-semibold mb-0" id="lowStockTitle">
            Low Stock Products
          </h2>

          <a class="small text-decoration-none" href="/admin/products">
            All Products
          </a>

        </div>

        <% if (lowStockProducts.length > 0) { %>

          <ul class="list-group list-group-flush">

            <% lowStockProducts.forEach(function(product) { %>

              <li class="list-group-item px-0 d-flex justify-content-between align-items-center gap-3">

                <span class="fw-semibold">
                  <%= product.name %>
                </span>

                <div class="d-flex align-items-center gap-2">

                  <% if (product.stock === 0) { %>

                    <span class="badge bg-danger">
                      Out of Stock
                    </span>

                  <% } else { %>

                    <span class="badge bg-warning text-dark">
                      <%= product.stock %> left
                    </span>

                  <% } %>

                  <a class="btn btn-sm btn-outline-primary"
                     href="/admin/products/<%= encodeURIComponent(String(product._id)) %>/edit">
                    Edit
                  </a>

                </div>

              </li>

            <% }) %>

          </ul>

        <% } else { %>

          <p class="text-secondary mb-0">
            No low-stock products right now.
          </p>

        <% } %>

      </div>
    </section>
  </div>

</div>


<!-- Recent Orders -->
<div class="row g-3">

  <div class="col-12">

    <section class="card" aria-labelledby="recentOrdersTitle">

      <div class="card-body p-0">

        <div class="d-flex justify-content-between align-items-center gap-3 p-3 p-md-4 pb-2">

          <h2 class="h5 fw-semibold mb-0" id="recentOrdersTitle">
            5 Recent Orders
          </h2>

          <a class="small text-decoration-none" href="/admin/orders">
            View All
          </a>

        </div>


        <% if (recentOrders.length > 0) { %>

          <div class="table-responsive">

            <table class="table table-striped table-hover small mb-0">

              <thead>
                <tr>
                  <th scope="col">Order</th>
                  <th scope="col">Customer</th>
                  <th scope="col">Date</th>
                  <th scope="col">Total</th>
                  <th scope="col">Status</th>
                  <th scope="col" class="text-end">Action</th>
                </tr>
              </thead>


              <tbody>

                <% recentOrders.forEach(function(order) {

                  var orderId = String(order._id);
                  var shortOrderId = orderId.slice(-8);

                %>

                  <tr>

                    <!-- Order ID -->
                    <td class="fw-semibold">
                      #<%= shortOrderId %>
                    </td>


                    <!-- Customer -->
                    <td>
                      <%= order.user ? order.user.name : 'Unknown' %>
                    </td>


                    <!-- Order Date -->
                    <td>
                      <%= new Date(order.createdAt).toLocaleDateString('en-IN') %>
                    </td>


                    <!-- Order Total -->
                    <td class="text-nowrap">
                      &#8377;<%= Number(order.totalAmount).toFixed(2) %>
                    </td>


                    <!-- Order Status -->
                    <td>

                      <span class="badge <%= orderStatusClasses[order.status] || 'bg-secondary' %>">
                        <%= order.status %>
                      </span>

                    </td>


                    <!-- View Order -->
                    <td class="text-end">

                      <a class="btn btn-sm btn-outline-primary"
                         href="/admin/orders/<%= encodeURIComponent(orderId) %>">
                        View
                      </a>

                    </td>

                  </tr>

                <% }) %>

              </tbody>

            </table>

          </div>

        <% } else { %>

          <p class="text-secondary px-3 px-md-4 pb-3 mb-0">
            No recent orders.
          </p>

        <% } %>

      </div>

    </section>

  </div>

</div>


<%- include('partials/admin-footer') %>
