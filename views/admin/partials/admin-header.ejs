<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
  <style>
    body {
      background: #f8fafc;
    }

    .admin-sidebar {
      width: 260px;
      background: #1e1b4b;
      color: #e0e7ff;
    }

    .admin-sidebar .nav-link {
      color: #c7d2fe;
      border-radius: .5rem;
      padding: .7rem .85rem;
    }

    .admin-sidebar .nav-link:hover,
    .admin-sidebar .nav-link.active {
      color: #fff;
      background: #4338ca;
    }

    .admin-desktop-sidebar {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 1030;
    }

    .admin-main {
      min-width: 0;
    }

    .admin-topbar {
      min-height: 4.5rem;
    }

    .admin-page-header {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .admin-page-header h2,
    .admin-page-header h3 {
      margin-bottom: 0;
    }

    @media (min-width: 576px) {
      .admin-page-header {
        flex-direction: row;
        align-items: center;
      }
    }

    .admin-page-content .card {
      border: 0;
      border-radius: .875rem;
      box-shadow: 0 .25rem 1rem rgba(15, 23, 42, .06);
    }

    .admin-page-content .table {
      font-size: .875rem;
      vertical-align: middle;
    }

    .admin-page-content .table > :not(caption) > * > * {
      padding: .75rem;
    }

    @media (min-width: 992px) {
      .admin-main {
        margin-left: 260px;
      }
    }
  </style>
</head>
<body>
  <aside class="admin-sidebar admin-desktop-sidebar d-none d-lg-flex flex-column p-3" aria-label="Admin sidebar">
    <a class="text-white text-decoration-none fs-5 fw-bold px-2 py-3 mb-3" href="/admin/categories">Shop Admin</a>
    <nav class="nav nav-pills flex-column gap-1">
      <a class="nav-link <%= activePage === 'categories' ? 'active' : '' %>" href="/admin/categories"><i class="bi bi-tags me-2" aria-hidden="true"></i>Categories</a>
      <a class="nav-link <%= activePage === 'products' ? 'active' : '' %>" href="/admin/products"><i class="bi bi-box-seam me-2" aria-hidden="true"></i>Products</a>
      <a class="nav-link <%= activePage === 'orders' ? 'active' : '' %>" href="/admin/orders"><i class="bi bi-receipt me-2" aria-hidden="true"></i>Orders</a>
      <a class="nav-link <%= activePage === 'coupons' ? 'active' : '' %>" href="/admin/coupons"><i class="bi bi-ticket-perforated me-2" aria-hidden="true"></i>Coupons</a>
      <a class="nav-link <%= activePage === 'reports' ? 'active' : '' %>" href="/admin/reports"><i class="bi bi-graph-up me-2" aria-hidden="true"></i>Sales Report</a>
    </nav>
    <div class="mt-auto pt-3">
      <a class="nav-link" href="/"><i class="bi bi-shop me-2" aria-hidden="true"></i>View store</a>
      <form action="/admin/logout" method="POST" class="mt-2">
        <button class="btn btn-sm btn-outline-light w-100 text-start" type="submit"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Logout</button>
      </form>
    </div>
  </aside>

  <div class="offcanvas offcanvas-start admin-sidebar" tabindex="-1" id="adminMobileSidebar" aria-labelledby="adminMobileSidebarLabel">
    <div class="offcanvas-header">
      <a class="text-white text-decoration-none fs-5 fw-bold" href="/admin/categories" id="adminMobileSidebarLabel">Shop Admin</a>
      <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close menu"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column">
      <nav class="nav nav-pills flex-column gap-1">
        <a class="nav-link <%= activePage === 'categories' ? 'active' : '' %>" href="/admin/categories"><i class="bi bi-tags me-2" aria-hidden="true"></i>Categories</a>
        <a class="nav-link <%= activePage === 'products' ? 'active' : '' %>" href="/admin/products"><i class="bi bi-box-seam me-2" aria-hidden="true"></i>Products</a>
        <a class="nav-link <%= activePage === 'orders' ? 'active' : '' %>" href="/admin/orders"><i class="bi bi-receipt me-2" aria-hidden="true"></i>Orders</a>
        <a class="nav-link <%= activePage === 'coupons' ? 'active' : '' %>" href="/admin/coupons"><i class="bi bi-ticket-perforated me-2" aria-hidden="true"></i>Coupons</a>
        <a class="nav-link <%= activePage === 'reports' ? 'active' : '' %>" href="/admin/reports"><i class="bi bi-graph-up me-2" aria-hidden="true"></i>Sales Report</a>
      </nav>
      <div class="mt-auto pt-3">
        <a class="nav-link" href="/"><i class="bi bi-shop me-2" aria-hidden="true"></i>View store</a>
        <form action="/admin/logout" method="POST" class="mt-2">
          <button class="btn btn-sm btn-outline-light w-100 text-start" type="submit"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Logout</button>
        </form>
      </div>
    </div>
  </div>

  <div class="admin-main">
    <header class="admin-topbar bg-white border-bottom sticky-top px-3 px-lg-4 d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-3">
        <button class="btn btn-outline-primary d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminMobileSidebar" aria-controls="adminMobileSidebar" aria-label="Open admin menu">
          <i class="bi bi-list" aria-hidden="true"></i>
        </button>
        <h1 class="h4 fw-semibold mb-0"><%= title %></h1>
      </div>
      <span class="text-secondary"><i class="bi bi-person-circle me-2" aria-hidden="true"></i><%= user && user.name ? user.name : 'Admin' %></span>
    </header>

    <%- include('../../partials/flash') %>
    <main class="admin-page-content container-fluid p-3 p-lg-4">
