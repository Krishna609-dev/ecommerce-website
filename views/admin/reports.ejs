
<%- include('partials/admin-header', { title: 'Sales Report', activePage: 'reports' }) %>

<%
  var statusRows = report ? [
    { name: 'Pending', count: report.statusCounts.Pending || 0, badge: 'bg-warning text-dark' },
    { name: 'Processing', count: report.statusCounts.Processing || 0, badge: 'bg-info text-dark' },
    { name: 'Shipped', count: report.statusCounts.Shipped || 0, badge: 'bg-primary' },
    { name: 'Delivered', count: report.statusCounts.Delivered || 0, badge: 'bg-success' },
    { name: 'Cancelled', count: report.statusCounts.Cancelled || 0, badge: 'bg-danger' },
    { name: 'Payment Failed', count: report.statusCounts['Payment Failed'] || 0, badge: 'bg-dark' }
  ] : [];
%>

<style>
  .sales-chart-container {
    position: relative;
    min-height: 280px;
  }

  @media print {
    .admin-sidebar,
    .admin-topbar,
    .report-filter-card,
    .report-print-button,
    #adminConfirmModal,
    footer {
      display: none !important;
    }

    .admin-main {
      margin: 0 !important;
      width: 100% !important;
    }

    .admin-page-content {
      padding: 0 !important;
    }

    body {
      background: #fff !important;
    }

    .card {
      box-shadow: none !important;
      border: 1px solid #dee2e6 !important;
      break-inside: avoid;
    }

    canvas {
      max-width: 100%;
    }
  }
</style>

<!-- Page heading -->
<div class="admin-page-header">
  <div>
    <h2 class="h3 fw-bold">Sales Report</h2>
    <p class="text-secondary mb-0">
      Review orders and sales for a selected date range.
    </p>
  </div>

  <% if (report) { %>
    <button class="btn btn-outline-primary report-print-button"
            type="button"
            onclick="window.print()">
      <i class="bi bi-printer me-1" aria-hidden="true"></i>
      Print Report
    </button>
  <% } %>
</div>

<!-- Error message -->
<% if (reportError) { %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <%= reportError %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"
            aria-label="Close"></button>
  </div>
<% } %>

<!-- Date filters -->
<section class="card report-filter-card mb-4"
         aria-labelledby="reportFiltersTitle">

  <div class="card-body p-3 p-md-4">

    <h3 class="h5 fw-semibold mb-3" id="reportFiltersTitle">
      Report date range
    </h3>

    <form action="/admin/reports" method="GET" id="reportFilterForm">

      <div class="row g-3 align-items-end">

        <div class="col-12 col-sm-6 col-lg-3">
          <label class="form-label" for="reportFrom">From</label>
          <input class="form-control"
                 id="reportFrom"
                 name="from"
                 type="date"
                 value="<%= from || '' %>"
                 required>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
          <label class="form-label" for="reportTo">To</label>
          <input class="form-control"
                 id="reportTo"
                 name="to"
                 type="date"
                 value="<%= to || '' %>"
                 required>
        </div>

        <div class="col-12 col-lg-auto">
          <button class="btn btn-primary w-100" type="submit">
            <i class="bi bi-file-earmark-bar-graph me-1"></i>
            Generate Report
          </button>
        </div>

        <div class="col-12">
          <div class="d-flex flex-wrap gap-2"
               aria-label="Quick date ranges">

            <button class="btn btn-sm btn-outline-secondary"
                    type="button"
                    data-report-range="today">
              Today
            </button>

            <button class="btn btn-sm btn-outline-secondary"
                    type="button"
                    data-report-range="7days">
              Last 7 Days
            </button>

            <button class="btn btn-sm btn-outline-secondary"
                    type="button"
                    data-report-range="month">
              This Month
            </button>

          </div>
        </div>

      </div>
    </form>
  </div>
</section>

<!-- No report selected -->
<% if (!report) { %>

  <div class="card">
    <div class="card-body text-center py-5">

      <i class="bi bi-calendar-range display-4 text-secondary"
         aria-hidden="true"></i>

      <h3 class="h5 mt-3">No report generated</h3>

      <p class="text-secondary mb-0">
        Select a date range and click Generate Report to view sales information.
      </p>

    </div>
  </div>

<% } else { %>

  <!-- Selected report period -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <div>
      <h3 class="h5 fw-semibold mb-1">Report Summary</h3>
      <p class="small text-secondary mb-0">
        Period: <%= from %> to <%= to %>
      </p>
    </div>
  </div>

  <!-- Summary cards -->
  <section class="row g-3 g-xl-4 mb-4"
           aria-label="Report summary">

    <div class="col-12 col-md-4">
      <article class="card h-100">
        <div class="card-body p-3 p-md-4">

          <p class="small text-secondary mb-2">Total Orders</p>

          <p class="h3 fw-bold mb-0">
            <%= Number(report.totalOrders).toLocaleString() %>
          </p>

          <i class="bi bi-bag-check text-primary"></i>

        </div>
      </article>
    </div>

    <div class="col-12 col-md-4">
      <article class="card h-100">
        <div class="card-body p-3 p-md-4">

          <p class="small text-secondary mb-2">Total Sales</p>

          <p class="h3 fw-bold mb-0">
            &#8377;<%= Number(report.totalSales).toFixed(2) %>
          </p>

          <i class="bi bi-currency-rupee text-success"></i>

        </div>
      </article>
    </div>

    <div class="col-12 col-md-4">
      <article class="card h-100">
        <div class="card-body p-3 p-md-4">

          <p class="small text-secondary mb-2">Average Order Value</p>

          <p class="h3 fw-bold mb-0">
            &#8377;<%= Number(report.averageOrderValue).toFixed(2) %>
          </p>

          <i class="bi bi-graph-up text-info"></i>

        </div>
      </article>
    </div>

  </section>

  <!-- Status breakdown -->
  <section class="card mb-4"
           aria-labelledby="statusBreakdownTitle">

    <div class="card-body p-3 p-md-4">

      <h3 class="h5 fw-semibold mb-3" id="statusBreakdownTitle">
        Order Status Breakdown
      </h3>

      <div class="d-flex flex-wrap gap-2">

        <% statusRows.forEach(function(row) { %>

          <span class="badge <%= row.badge %> p-2">
            <%= row.name %>: <%= Number(row.count).toLocaleString() %>
          </span>

        <% }) %>

      </div>
    </div>
  </section>

  <!-- Daily sales chart -->
  <section class="card mb-4"
           aria-labelledby="dailySalesChartTitle">

    <div class="card-body p-3 p-md-4">

      <h3 class="h5 fw-semibold mb-3" id="dailySalesChartTitle">
        Sales Per Day
      </h3>

      <% if (report.daily && report.daily.length > 0) { %>

        <div class="sales-chart-container">
          <canvas id="dailySalesChart"
                  role="img"
                  aria-label="Bar chart showing daily sales">
          </canvas>
        </div>

        <div id="dailySalesChartData"
             data-daily="<%= JSON.stringify(report.daily) %>"
             hidden>
        </div>

      <% } else { %>

        <p class="text-secondary mb-0">
          No daily sales data available for this date range.
        </p>

      <% } %>

    </div>
  </section>

  <!-- Daily sales table -->
  <section class="card"
           aria-labelledby="dailySalesTableTitle">

    <div class="card-body p-0">

      <div class="p-3 p-md-4 pb-2">
        <h3 class="h5 fw-semibold mb-0" id="dailySalesTableTitle">
          Daily Sales Details
        </h3>
      </div>

      <div class="table-responsive">

        <table class="table table-striped table-hover small mb-0">

          <thead>
            <tr>
              <th scope="col">Date</th>
              <th scope="col">Orders</th>
              <th scope="col" class="text-end">Sales</th>
            </tr>
          </thead>

          <tbody>

            <% if (report.daily && report.daily.length > 0) { %>

              <% report.daily.forEach(function(day) { %>

                <tr>
                  <td><%= day.date %></td>

                  <td>
                    <%= Number(day.orders).toLocaleString() %>
                  </td>

                  <td class="text-end text-nowrap">
                    &#8377;<%= Number(day.sales).toFixed(2) %>
                  </td>
                </tr>

              <% }) %>

            <% } else { %>

              <tr>
                <td colspan="3" class="text-center text-secondary py-4">
                  No orders found for this date range.
                </td>
              </tr>

            <% } %>

            <tr class="fw-bold">
              <th scope="row">Total</th>

              <td>
                <%= Number(report.totalOrders).toLocaleString() %>
              </td>

              <td class="text-end text-nowrap">
                &#8377;<%= Number(report.totalSales).toFixed(2) %>
              </td>
            </tr>

          </tbody>
        </table>
      </div>
    </div>
  </section>

<% } %>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  (function () {

    var fromInput = document.getElementById('reportFrom');
    var toInput = document.getElementById('reportTo');
    var reportForm = document.getElementById('reportFilterForm');

    function toDateInputValue(date) {
      var year = date.getFullYear();
      var month = String(date.getMonth() + 1).padStart(2, '0');
      var day = String(date.getDate()).padStart(2, '0');

      return year + '-' + month + '-' + day;
    }

    // Quick date range buttons
    document.querySelectorAll('[data-report-range]').forEach(function (button) {

      button.addEventListener('click', function () {

        var today = new Date();
        var start = new Date(today);

        if (button.dataset.reportRange === '7days') {
          start.setDate(today.getDate() - 6);
        } else if (button.dataset.reportRange === 'month') {
          start = new Date(today.getFullYear(), today.getMonth(), 1);
        }

        fromInput.value = toDateInputValue(start);
        toInput.value = toDateInputValue(today);

        // Automatically generate the selected report
        reportForm.requestSubmit();

      });

    });

    // Prevent selecting an end date before the start date
    fromInput.addEventListener('change', function () {
      toInput.min = fromInput.value;
    });

    toInput.addEventListener('change', function () {
      fromInput.max = toInput.value;
    });

    // Chart display
    var chartDataElement = document.getElementById('dailySalesChartData');

    if (chartDataElement && window.Chart) {

      try {

        var dailyData = JSON.parse(chartDataElement.dataset.daily);
        var chartCanvas = document.getElementById('dailySalesChart');

        new Chart(chartCanvas, {

          type: 'bar',

          data: {
            labels: dailyData.map(function (day) {
              return day.date;
            }),

            datasets: [{
              label: 'Sales (₹)',

              data: dailyData.map(function (day) {
                return Number(day.sales);
              }),

              backgroundColor: 'rgba(67, 56, 202, 0.75)',
              borderColor: '#4338ca',
              borderWidth: 1,
              borderRadius: 6
            }]
          },

          options: {
            responsive: true,
            maintainAspectRatio: false,

            scales: {
              y: {
                beginAtZero: true,

                ticks: {
                  callback: function (value) {
                    return '₹' + Number(value).toLocaleString();
                  }
                }
              }
            },

            plugins: {
              tooltip: {
                callbacks: {
                  label: function (context) {
                    return 'Sales: ₹' + Number(context.parsed.y).toFixed(2);
                  }
                }
              }
            }
          }

        });

      } catch (error) {
        console.error('Unable to display sales chart:', error);
      }
    }

  })();
</script>

<%- include('partials/admin-footer') %>
