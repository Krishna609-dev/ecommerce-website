<%- include('partials/admin-header', { title: 'Products', activePage: 'products' }) %>

<div class="admin-page-header">
  <div>
    <h2 class="h3 fw-bold">Products</h2>
    <p class="text-secondary mb-0">Manage your store's product inventory.</p>
  </div>
  <a class="btn btn-primary" href="/admin/products/new">
    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add product
  </a>
</div>

<section class="card" aria-labelledby="productListTitle">
  <div class="card-body p-0">
    <h3 class="visually-hidden" id="productListTitle">Product list</h3>
    <% if (products.length) { %>
      <div class="table-responsive">
        <table class="table table-striped table-hover small mb-0">
          <thead>   cx
            <tr>
              <th scope="col">Image</th>
              <th scope="col">Name</th>
              <th scope="col">Category</th>
              <th scope="col">Price</th>
              <th scope="col">Stock</th>
              <th scope="col">Quick stock update</th>
              <th scope="col" class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(function(product) {
              var productId = String(product._id);
              var hasImage = product.images && product.images.length > 0;
            %>
              <tr>
                <td>
                  <% if (hasImage) { %>
                    <img
                      src="/uploads/<%= encodeURIComponent(product.images[0]) %>"
                      alt="<%= product.name %>"
                      width="56"
                      height="42"
                      class="rounded object-fit-cover">
                  <% } else { %>
                    <div class="d-flex align-items-center justify-content-center rounded bg-secondary-subtle text-secondary"
                         style="width: 56px; height: 42px;"
                         role="img"
                         aria-label="No image available for <%= product.name %>">
                      <i class="bi bi-image" aria-hidden="true"></i>
                    </div>
                  <% } %>
                </td>
                <td class="fw-semibold"><%= product.name %></td>
                <td><%= product.category.name %></td>
                <td>&#8377;<%= Number(product.price).toFixed(2) %></td>
                <td>
                  <% if (product.stock === 0) { %>
                    <span class="badge bg-danger">Out of stock</span>
                  <% } else if (product.stock <= 5) { %>
                    <span class="badge bg-warning text-dark"><%= product.stock %> left</span>
                  <% } else { %>
                    <span class="badge bg-success"><%= product.stock %> in stock</span>
                  <% } %>
                </td>
                <td>
                  <form action="/admin/products/<%= encodeURIComponent(productId) %>/stock" method="POST" class="d-flex align-items-center gap-2">
                    <label class="visually-hidden" for="stock-<%= productId %>">New stock for <%= product.name %></label>
                    <input
                      class="form-control form-control-sm"
                      id="stock-<%= productId %>"
                      name="stock"
                      type="number"
                      min="0"
                      step="1"
                      value="<%= product.stock %>"
                      required
                      style="width: 5.5rem;">
                    <button class="btn btn-sm btn-outline-primary" type="submit">Save</button>
                  </form>
                </td>
                <td>
                  <div class="d-flex justify-content-end gap-2">
                    <a class="btn btn-sm btn-outline-primary" href="/admin/products/<%= encodeURIComponent(productId) %>/edit">Edit</a>
                    <button
                      class="btn btn-sm btn-outline-danger"
                      type="button"
                      data-bs-toggle="modal"
                      data-bs-target="#deleteProductModal"
                      data-product-id="<%= productId %>"
                      data-product-name="<%= product.name %>">
                      Delete
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="text-center px-4 py-5">
        <h3 class="h5 fw-semibold">No products yet</h3>
        <p class="text-secondary mb-4">Add your first product to start building your catalog.</p>
        <a class="btn btn-primary" href="/admin/products/new">Add product</a>
      </div>
    <% } %>
  </div>
</section>

<div class="mt-4">
  <%- include('../partials/pagination') %>
</div>

<div class="modal fade" id="deleteProductModal" tabindex="-1" aria-labelledby="deleteProductTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form id="deleteProductForm" method="POST">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="deleteProductTitle">Delete product?</h2>
          <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          Delete <strong id="deleteProductName"></strong>? This action cannot be undone.
        </div>
        <div class="modal-footer">
          <button class="btn btn-outline-danger" type="button" data-bs-dismiss="modal">Cancel</button>
          <button class="btn btn-danger" type="submit">Delete</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.getElementById('deleteProductModal').addEventListener('show.bs.modal', function (event) {
    var trigger = event.relatedTarget;
    var productId = trigger.dataset.productId;
    document.getElementById('deleteProductForm').action =
      '/admin/products/' + encodeURIComponent(productId) + '?_method=DELETE';
    document.getElementById('deleteProductName').textContent = trigger.dataset.productName;
  });
</script>

<%- include('partials/admin-footer') %>
