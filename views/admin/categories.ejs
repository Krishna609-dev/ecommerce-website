<%- include('partials/admin-header', { title: 'Categories', activePage: 'categories' }) %>

<div class="admin-page-header">
  <div>
    <h2 class="h3 fw-bold">Categories</h2>
    <p class="text-secondary mb-0">Manage the categories shown in your store.</p>
  </div>
  <a class="btn btn-primary" href="#addCategoryTitle">Add category</a>
</div>

<% if (errors.length) { %>
  <div class="alert alert-danger" role="alert" aria-labelledby="categoryErrorsTitle">
    <h3 class="h6 alert-heading" id="categoryErrorsTitle">Please review the following errors:</h3>
    <ul class="mb-0">
      <% errors.forEach(function(item) { %>
        <li><%= item.msg %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<section class="card mb-4" aria-labelledby="addCategoryTitle">
  <div class="card-body p-3 p-md-4">
    <h3 class="h5 fw-semibold mb-3" id="addCategoryTitle">Add category</h3>
    <form action="/admin/categories" method="POST" class="row g-2 align-items-end">
      <div class="col-12 col-sm">
        <label class="form-label" for="newCategoryName">Category name</label>
        <input class="form-control" id="newCategoryName" name="name" type="text" required>
      </div>
      <div class="col-12 col-sm-auto">
        <button class="btn btn-primary w-100" type="submit">Add</button>
      </div>
    </form>
  </div>
</section>

<section class="card" aria-labelledby="categoryListTitle">
  <div class="card-body p-0">
    <h3 class="visually-hidden" id="categoryListTitle">Category list</h3>
    <% if (categories.length) { %>
      <div class="table-responsive">
        <table class="table table-striped table-hover small mb-0">
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Status</th>
              <th scope="col" class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% categories.forEach(function(category) { %>
              <tr>
                <td class="fw-semibold"><%= category.name %></td>
                <td>
                  <% if (category.isActive) { %>
                    <span class="badge bg-success">Active</span>
                  <% } else { %>
                    <span class="badge bg-secondary">Inactive</span>
                  <% } %>
                </td>
                <td>
                  <div class="d-flex justify-content-end gap-2">
                    <button
                      class="btn btn-sm btn-outline-primary"
                      type="button"
                      data-bs-toggle="modal"
                      data-bs-target="#editCategoryModal"
                      data-category-id="<%= String(category._id) %>"
                      data-category-name="<%= category.name %>"
                      data-category-active="<%= category.isActive ? 'true' : 'false' %>">
                      Edit
                    </button>
                    <button
                      class="btn btn-sm btn-outline-danger"
                      type="button"
                      data-bs-toggle="modal"
                      data-bs-target="#deleteCategoryModal"
                      data-category-id="<%= String(category._id) %>"
                      data-category-name="<%= category.name %>">
                      Delete
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="text-center px-4 py-5">
        <h3 class="h5 fw-semibold">No categories yet</h3>
        <p class="text-secondary mb-0">Add a category above to get started.</p>
      </div>
    <% } %>
  </div>
</section>

<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-labelledby="editCategoryTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form id="editCategoryForm" method="POST">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="editCategoryTitle">Edit category</h2>
          <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label" for="editCategoryName">Category name</label>
            <input class="form-control" id="editCategoryName" name="name" type="text" required>
          </div>
          <div class="form-check">
            <input class="form-check-input" id="editCategoryActive" name="isActive" type="checkbox" value="true">
            <label class="form-check-label" for="editCategoryActive">Active</label>
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-outline-danger" type="button" data-bs-dismiss="modal">Cancel</button>
          <button class="btn btn-primary" type="submit">Save changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="deleteCategoryModal" tabindex="-1" aria-labelledby="deleteCategoryTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form id="deleteCategoryForm" method="POST">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="deleteCategoryTitle">Delete category?</h2>
          <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          Delete <strong id="deleteCategoryName"></strong>? This action cannot be undone.
        </div>
        <div class="modal-footer">
          <button class="btn btn-outline-danger" type="button" data-bs-dismiss="modal">Cancel</button>
          <button class="btn btn-danger" type="submit">Delete</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.getElementById('editCategoryModal').addEventListener('show.bs.modal', function (event) {
    var trigger = event.relatedTarget;
    var categoryId = trigger.dataset.categoryId;
    var form = document.getElementById('editCategoryForm');
    form.action = '/admin/categories/' + encodeURIComponent(categoryId) + '?_method=PUT';
    document.getElementById('editCategoryName').value = trigger.dataset.categoryName;
    document.getElementById('editCategoryActive').checked = trigger.dataset.categoryActive === 'true';
  });

  document.getElementById('deleteCategoryModal').addEventListener('show.bs.modal', function (event) {
    var trigger = event.relatedTarget;
    var categoryId = trigger.dataset.categoryId;
    document.getElementById('deleteCategoryForm').action =
      '/admin/categories/' + encodeURIComponent(categoryId) + '?_method=DELETE';
    document.getElementById('deleteCategoryName').textContent = trigger.dataset.categoryName;
  });
</script>

<%- include('partials/admin-footer') %>
