<%
  var orderId = String(order._id);
  var shortOrderId = orderId.length > 8 ? orderId.slice(-8) : orderId;
  var orderStatusClass = {
    'Pending': 'bg-warning text-dark',
    'Processing': 'bg-info text-dark',
    'Shipped': 'bg-primary',
    'Delivered': 'bg-success',
    'Cancelled': 'bg-danger'
  }[order.status] || 'bg-secondary';
  var paymentStatusClass = {
    'Paid': 'bg-success',
    'Pending': 'bg-warning text-dark',
    'Failed': 'bg-danger',
    'Refund Pending': 'bg-secondary'
  }[order.paymentStatus] || 'bg-secondary';
  var timelineStatuses = ['Pending', 'Processing', 'Shipped', 'Delivered'];
  var currentTimelineIndex = timelineStatuses.indexOf(order.status);
%>
<%- include('partials/admin-header', { title: 'Order #' + shortOrderId, activePage: 'orders' }) %>

<div class="admin-page-header">
  <div>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
      <h2 class="h3 fw-bold mb-0">Order #<%= shortOrderId %></h2>
      <span class="badge <%= orderStatusClass %>"><%= order.status %></span>
    </div>
    <p class="text-secondary mb-0">Placed <%= new Date(order.createdAt).toLocaleString() %></p>
  </div>
  <a class="btn btn-outline-primary" href="/admin/orders">
    <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to orders
  </a>
</div>

<% if (order.status === 'Cancelled') { %>
  <div class="alert alert-danger" role="alert">
    <i class="bi bi-x-circle me-2" aria-hidden="true"></i>This order has been cancelled.
  </div>
<% } else { %>
  <section class="card mb-4" aria-labelledby="orderTimelineTitle">
    <div class="card-body p-3 p-md-4">
      <h3 class="h5 fw-semibold mb-4" id="orderTimelineTitle">Order timeline</h3>
      <div class="d-flex justify-content-between position-relative">
        <% timelineStatuses.forEach(function(status, index) {
          var isComplete = currentTimelineIndex >= index;
        %>
          <div class="text-center position-relative px-1" style="z-index: 1; width: 25%;">
            <span class="d-inline-flex align-items-center justify-content-center rounded-circle <%= isComplete ? 'bg-primary text-white' : 'bg-secondary-subtle text-secondary' %>" style="width: 2rem; height: 2rem;">
              <% if (isComplete) { %>
                <i class="bi bi-check" aria-hidden="true"></i>
              <% } else { %>
                <%= index + 1 %>
              <% } %>
            </span>
            <span class="d-block small mt-2 <%= isComplete ? 'fw-semibold text-primary' : 'text-secondary' %>"><%= status %></span>
          </div>
        <% }) %>
      </div>
      <div class="progress mt-3" role="progressbar" aria-label="Order progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= currentTimelineIndex < 0 ? 0 : currentTimelineIndex * 100 / (timelineStatuses.length - 1) %>" style="height: .25rem;">
        <div class="progress-bar" style="width: <%= currentTimelineIndex < 0 ? 0 : currentTimelineIndex * 100 / (timelineStatuses.length - 1) %>%"></div>
      </div>
    </div>
  </section>
<% } %>

<div class="row g-4 align-items-start">
  <div class="col-12 col-lg-8">
    <div class="row g-4 mb-4">
      <div class="col-12 col-md-6">
        <section class="card h-100" aria-labelledby="customerTitle">
          <div class="card-body p-3 p-md-4">
            <h3 class="h5 fw-semibold mb-3" id="customerTitle">Customer</h3>
            <p class="fw-semibold mb-1"><%= order.user.name %></p>
            <p class="text-secondary mb-1"><%= order.user.email %></p>
            <p class="text-secondary mb-0"><%= order.user.phone || '—' %></p>
          </div>
        </section>
      </div>
      <div class="col-12 col-md-6">
        <section class="card h-100" aria-labelledby="deliveryAddressTitle">
          <div class="card-body p-3 p-md-4">
            <h3 class="h5 fw-semibold mb-3" id="deliveryAddressTitle">Delivery address</h3>
            <address class="text-secondary mb-0">
              <span class="d-block fw-semibold text-body"><%= order.address.fullName %></span>
              <%= order.address.street %><br>
              <%= order.address.city %>, <%= order.address.state %> <%= order.address.pincode %><br>
              <%= order.address.phone %>
            </address>
          </div>
        </section>
      </div>
    </div>

    <section class="card mb-4" aria-labelledby="orderItemsTitle">
      <div class="card-body p-0">
        <div class="p-3 p-md-4 pb-2">
          <h3 class="h5 fw-semibold mb-0" id="orderItemsTitle">Items</h3>
        </div>
        <div class="table-responsive">
          <table class="table table-striped table-hover small mb-0">
            <thead>
              <tr>
                <th scope="col">Product</th>
                <th scope="col">Unit price</th>
                <th scope="col">Quantity</th>
                <th scope="col" class="text-end">Line total</th>
              </tr>
            </thead>
            <tbody>
              <% order.items.forEach(function(item) { %>
                <tr>
                  <td class="fw-semibold"><%= item.name %></td>
                  <td class="text-nowrap">&#8377;<%= Number(item.price).toFixed(2) %></td>
                  <td><%= item.quantity %></td>
                  <td class="text-end text-nowrap">&#8377;<%= (Number(item.price) * Number(item.quantity)).toFixed(2) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="card" aria-labelledby="paymentTitle">
      <div class="card-body p-3 p-md-4">
        <h3 class="h5 fw-semibold mb-3" id="paymentTitle">Payment</h3>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
          <span class="text-secondary me-1">Method:</span>
          <span class="fw-semibold"><%= order.paymentMethod %></span>
          <span class="text-secondary ms-2 me-1">Status:</span>
          <span class="badge <%= paymentStatusClass %>"><%= order.paymentStatus %></span>
        </div>
        <p class="small text-secondary mb-0">
          Payment ID: <span class="text-body"><%= order.razorpayPaymentId || 'Not available' %></span>
        </p>
      </div>
    </section>
  </div>

  <aside class="col-12 col-lg-4">
    <section class="card mb-4" aria-labelledby="priceSummaryTitle">
      <div class="card-body p-3 p-md-4">
        <h3 class="h5 fw-semibold mb-4" id="priceSummaryTitle">Price summary</h3>
        <div class="d-flex justify-content-between mb-3">
          <span class="text-secondary">Subtotal</span>
          <span>&#8377;<%= Number(order.subtotal).toFixed(2) %></span>
        </div>
        <% if (order.discount > 0) { %>
          <div class="d-flex justify-content-between text-success mb-3">
            <span>Discount<% if (order.couponCode) { %> (<%= order.couponCode %>)<% } %></span>
            <span>- &#8377;<%= Number(order.discount).toFixed(2) %></span>
          </div>
        <% } %>
        <hr>
        <div class="d-flex justify-content-between fw-bold fs-5">
          <span>Total</span>
          <span>&#8377;<%= Number(order.totalAmount).toFixed(2) %></span>
        </div>
      </div>
    </section>

    <section class="card" aria-labelledby="updateStatusTitle">
      <div class="card-body p-3 p-md-4">
        <h3 class="h5 fw-semibold mb-3" id="updateStatusTitle">Update status</h3>
        <% if (nextStatuses.length) { %>
          <form action="/admin/orders/<%= encodeURIComponent(orderId) %>/status" method="POST">
            <label class="form-label" for="orderStatus">New status</label>
            <select class="form-select mb-3" id="orderStatus" name="status" required>
              <option value="">Choose status</option>
              <% nextStatuses.forEach(function(status) { %>
                <option value="<%= status %>"><%= status %></option>
              <% }) %>
            </select>
            <button class="btn btn-primary w-100" type="submit">Update</button>
          </form>
        <% } else { %>
          <p class="text-secondary mb-0">This order can no longer be updated.</p>
        <% } %>
      </div>
    </section>
  </aside>
</div>

<%- include('partials/admin-footer') %>
