<%- include('../partials/header', { title: 'My addresses' }) %>
<%- include('../partials/flash') %>

<section class="container py-4 py-md-5">
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
      <h1 class="h2 fw-bold mb-1">My addresses</h1>
      <p class="text-secondary mb-0">Manage your delivery addresses.</p>
    </div>
    <a class="btn btn-primary" href="/addresses/new">
      <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add new address
    </a>
  </div>

  <% if (addresses.length) { %>
    <div class="row g-3 g-md-4">
      <% addresses.forEach(function(address) { %>
        <div class="col-12 col-md-6 col-xl-4">
          <article class="card h-100 border-0 shadow-sm rounded-4">
            <div class="card-body d-flex flex-column p-4">
              <h2 class="h5 fw-semibold mb-3"><%= address.fullName %></h2>
              <address class="text-secondary mb-4">
                <%= address.street %><br>
                <%= address.city %>, <%= address.state %> <%= address.pincode %><br>
                <span class="text-body"><%= address.phone %></span>
              </address>
              <div class="d-flex gap-2 mt-auto">
                <a class="btn btn-outline-primary btn-sm" href="/addresses/<%= encodeURIComponent(String(address._id)) %>/edit">Edit</a>
                <form action="/addresses/<%= encodeURIComponent(String(address._id)) %>?_method=DELETE" method="POST" data-confirm="Delete this address?">
                  <button class="btn btn-outline-danger btn-sm" type="submit">Delete</button>
                </form>
              </div>
            </div>
          </article>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="card border-0 shadow-sm rounded-4 text-center">
      <div class="card-body p-4 p-md-5">
        <i class="bi bi-geo-alt display-3 text-secondary" aria-hidden="true"></i>
        <h2 class="h4 fw-semibold mt-3">No addresses saved</h2>
        <p class="text-secondary mb-4">Add an address to make checkout quicker.</p>
        <a class="btn btn-primary" href="/addresses/new">Add new address</a>
      </div>
    </div>
  <% } %>
</section>

<script>
  document.querySelectorAll('form[data-confirm]').forEach(function (form) {
    form.addEventListener('submit', function (event) {
      if (!window.confirm(form.dataset.confirm)) {
        event.preventDefault();
      }
    });
  });
</script>

<%- include('../partials/footer') %>
