<%
  var orderId = String(order._id);
  var shortOrderId = orderId.slice(-8);
  var orderStatusClasses = {
    'Pending': 'bg-warning text-dark',
    'Processing': 'bg-info text-dark',
    'Shipped': 'bg-primary',
    'Delivered': 'bg-success',
    'Cancelled': 'bg-danger'
  };
  var paymentStatusClasses = {
    'Paid': 'bg-success',
    'Pending': 'bg-warning text-dark',
    'Failed': 'bg-danger',
    'Refund Pending': 'bg-secondary'
  };
  var trackingSteps = ['Pending', 'Processing', 'Shipped', 'Delivered'];
  var currentStep = trackingSteps.indexOf(order.status);
%>
<%- include('../partials/header', { title: 'Order #' + shortOrderId }) %>
<%- include('../partials/flash') %>

<style>
  .order-tracking-step {
    position: relative;
    z-index: 1;
    width: 25%;
  }

  .order-tracking-line {
    position: absolute;
    top: 1rem;
    right: 12.5%;
    left: 12.5%;
    height: .2rem;
  }
  
  .order-tracking-step-label {
    font-size: .75rem;
  }
  
  @media (min-width: 576px) {
    .order-tracking-step-label {
      font-size: .875rem;
    }
  }
</style>

<section class="container py-4 py-md-5">
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-start gap-3 mb-4">
    <div>
      <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <h1 class="h2 fw-bold mb-0">Order #<%= shortOrderId %></h1>
        <span class="badge <%= orderStatusClasses[order.status] || 'bg-secondary' %>"><%= order.status %></span>
      </div>
      <p class="text-secondary mb-0">Placed <%= new Date(order.createdAt).toLocaleString() %></p>
    </div>
    <a class="btn btn-outline-primary" href="/orders">
      <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to orders
    </a>
  </div>

  <% if (order.status === 'Cancelled') { %>
    <div class="alert alert-danger fw-semibold" role="alert">
      <i class="bi bi-x-circle me-2" aria-hidden="true"></i>Order cancelled
    </div>
  <% } else { %>
    <section class="card border-0 shadow-sm rounded-4 mb-4" aria-labelledby="trackingTitle">
      <div class="card-body p-3 p-md-4">
        <h2 class="h5 fw-semibold mb-4" id="trackingTitle">Order tracking</h2>
        <div class="position-relative">
          <div class="progress order-tracking-line" aria-hidden="true">
            <div class="progress-bar bg-success" style="width: <%= currentStep <= 0 ? 0 : currentStep * 100 / (trackingSteps.length - 1) %>%"></div>
          </div>
          <ol class="list-unstyled d-flex justify-content-between mb-0">
            <% trackingSteps.forEach(function(step, index) {
              var isCompleted = currentStep >= 0 && index < currentStep;
              var isCurrent = index === currentStep;
              var stepClasses = isCompleted
                ? 'bg-success text-white'
                : (isCurrent ? 'bg-primary text-white' : 'bg-secondary-subtle text-secondary');
            %>
              <li class="order-tracking-step text-center">
                <span class="d-inline-flex align-items-center justify-content-center rounded-circle <%= stepClasses %>" style="width: 2rem; height: 2rem;">
                  <% if (isCompleted) { %>
                    <i class="bi bi-check" aria-hidden="true"></i>
                  <% } else { %>
                    <span class="visually-hidden"><%= step %></span>
                    <span aria-hidden="true"><%= index + 1 %></span>
                  <% } %>
                </span>
                <span class="d-block mt-2 order-tracking-step-label <%= isCurrent || isCompleted ? 'fw-semibold text-body' : 'text-secondary' %>"><%= step %></span>
              </li>
            <% }) %>
          </ol>
        </div>
      </div>
    </section>
  <% } %>

  <% if (order.paymentStatus === 'Refund Pending') { %>
    <div class="alert alert-info" role="status">
      <i class="bi bi-info-circle me-2" aria-hidden="true"></i>Your refund is being processed.
    </div>
  <% } %>

  <div class="row g-4 align-items-start">
    <div class="col-12 col-lg-8">
      <section class="card border-0 shadow-sm rounded-4 mb-4" aria-labelledby="itemsTitle">
        <div class="card-body p-0">
          <div class="p-3 p-md-4 pb-2">
            <h2 class="h5 fw-semibold mb-0" id="itemsTitle">Order items</h2>
          </div>
          <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
              <thead>
                <tr>
                  <th scope="col">Name</th>
                  <th scope="col">Price</th>
                  <th scope="col">Quantity</th>
                  <th scope="col" class="text-end">Line total</th>
                </tr>
              </thead>
              <tbody>
                <% order.items.forEach(function(item) { %>
                  <tr>
                    <td class="fw-semibold"><%= item.name %></td>
                    <td class="text-nowrap">&#8377;<%= Number(item.price).toFixed(2) %></td>
                    <td><%= item.quantity %></td>
                    <td class="text-end text-nowrap">&#8377;<%= (Number(item.price) * Number(item.quantity)).toFixed(2) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <div class="row g-4">
        <div class="col-12 col-md-6">
          <section class="card h-100 border-0 shadow-sm rounded-4" aria-labelledby="deliveryTitle">
            <div class="card-body p-3 p-md-4">
              <h2 class="h5 fw-semibold mb-3" id="deliveryTitle">Delivery address</h2>
              <address class="text-secondary mb-0">
                <span class="d-block fw-semibold text-body"><%= order.address.fullName %></span>
                <%= order.address.street %><br>
                <%= order.address.city %>, <%= order.address.state %> <%= order.address.pincode %><br>
                <%= order.address.phone %>
              </address>
            </div>
          </section>
        </div>

        <div class="col-12 col-md-6">
          <section class="card h-100 border-0 shadow-sm rounded-4" aria-labelledby="paymentTitle">
            <div class="card-body p-3 p-md-4">
              <h2 class="h5 fw-semibold mb-3" id="paymentTitle">Payment</h2>
              <p class="mb-2"><span class="text-secondary">Method:</span> <strong><%= order.paymentMethod %></strong></p>
              <p class="mb-2">
                <span class="text-secondary">Status:</span>
                <span class="badge <%= paymentStatusClasses[order.paymentStatus] || 'bg-secondary' %>"><%= order.paymentStatus %></span>
              </p>
              <% if (order.razorpayPaymentId) { %>
                <p class="small text-secondary mb-0">Razorpay payment ID: <span class="text-body"><%= order.razorpayPaymentId %></span></p>
              <% } %>
            </div>
          </section>
        </div>
      </div>
    </div>

    <aside class="col-12 col-lg-4" aria-labelledby="summaryTitle">
      <section class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-3 p-md-4">
          <h2 class="h5 fw-bold mb-4" id="summaryTitle">Price summary</h2>
          <div class="d-flex justify-content-between mb-3">
            <span class="text-secondary">Subtotal</span>
            <span>&#8377;<%= Number(order.subtotal).toFixed(2) %></span>
          </div>
          <% if (order.discount > 0) { %>
            <div class="d-flex justify-content-between text-success mb-3">
              <span>Discount<% if (order.couponCode) { %> (<%= order.couponCode %>)<% } %></span>
              <span>- &#8377;<%= Number(order.discount).toFixed(2) %></span>
            </div>
          <% } %>
          <hr>
          <div class="d-flex justify-content-between fw-bold fs-5 mb-4">
            <span>Total</span>
            <span>&#8377;<%= Number(order.totalAmount).toFixed(2) %></span>
          </div>

          <div class="d-grid gap-2">
            <a class="btn btn-primary" href="/orders/<%= encodeURIComponent(orderId) %>/invoice">
              <i class="bi bi-download me-1" aria-hidden="true"></i>Download invoice
            </a>
            <% if (order.status === 'Pending' || order.status === 'Processing') { %>
              <form action="/orders/<%= encodeURIComponent(orderId) %>/cancel" method="POST" data-confirm="Are you sure you want to cancel this order?">
                <button class="btn btn-outline-danger w-100" type="submit">Cancel order</button>
              </form>
            <% } %>
            <a class="btn btn-outline-primary" href="/orders">Back to orders</a>
          </div>
        </div>
      </section>
    </aside>
  </div>
</section>

<script>
  document.querySelectorAll('form[data-confirm]').forEach(function (form) {
    form.addEventListener('submit', function (event) {
      if (!window.confirm(form.dataset.confirm)) {
        event.preventDefault();
      }
    });
  });
</script>

<%- include('../partials/footer') %>
