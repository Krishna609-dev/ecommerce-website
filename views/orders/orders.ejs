<%- include('../partials/header', { title: 'My orders' }) %>
<%- include('../partials/flash') %>

<%
  var orderStatusClasses = {
    'Pending': 'bg-warning text-dark',
    'Processing': 'bg-info text-dark',
    'Shipped': 'bg-primary',
    'Delivered': 'bg-success',
    'Cancelled': 'bg-danger'
  };
  var paymentStatusClasses = {
    'Paid': 'bg-success',
    'Pending': 'bg-warning text-dark',
    'Failed': 'bg-danger',
    'Refund Pending': 'bg-secondary'
  };
%>

<section class="container py-4 py-md-5">
  <div class="mb-4">
    <h1 class="h2 fw-bold mb-1">My orders</h1>
    <p class="text-secondary mb-0">View your order history and invoices.</p>
  </div>

  <% if (orders.length) { %>
    <div class="d-grid gap-3">
      <% orders.forEach(function(order) {
        var orderId = String(order._id);
        var shortOrderId = orderId.slice(-8);
        var itemCount = order.items ? order.items.length : 0;
      %>
        <article class="card border-0 shadow-sm rounded-4">
          <div class="card-body p-3 p-md-4">
            <div class="d-flex flex-column flex-md-row justify-content-between gap-3">
              <div>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                  <h2 class="h5 fw-bold mb-0">Order #<%= shortOrderId %></h2>
                  <span class="badge <%= orderStatusClasses[order.status] || 'bg-secondary' %>"><%= order.status %></span>
                </div>
                <p class="text-secondary small mb-0">
                  Placed <%= new Date(order.createdAt).toLocaleDateString() %>
                  <span class="mx-1" aria-hidden="true">&bull;</span>
                  <%= itemCount %> <%= itemCount === 1 ? 'item' : 'items' %>
                </p>
              </div>

              <div class="d-flex flex-wrap align-items-center gap-3">
                <div>
                  <span class="d-block small text-secondary">Total</span>
                  <span class="fw-bold">&#8377;<%= Number(order.totalAmount).toFixed(2) %></span>
                </div>
                <div>
                  <span class="d-block small text-secondary">Payment</span>
                  <span class="small"><%= order.paymentMethod %></span>
                </div>
                <span class="badge <%= paymentStatusClasses[order.paymentStatus] || 'bg-secondary' %>"><%= order.paymentStatus %></span>
              </div>
            </div>

            <div class="d-flex justify-content-end gap-2 border-top mt-3 pt-3">
              <a class="btn btn-sm btn-outline-primary" href="/orders/<%= encodeURIComponent(orderId) %>">View details</a>
              <a class="btn btn-sm btn-outline-secondary" href="/orders/<%= encodeURIComponent(orderId) %>/invoice" aria-label="View invoice for order <%= shortOrderId %>" title="Invoice">
                <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                <span class="visually-hidden">Invoice</span>
              </a>
            </div>
          </div>
        </article>
      <% }) %>
    </div>

    <div class="mt-4">
      <%- include('../partials/pagination') %>
    </div>
  <% } else { %>
    <div class="card border-0 shadow-sm rounded-4 text-center">
      <div class="card-body p-4 p-md-5">
        <i class="bi bi-receipt display-3 text-secondary" aria-hidden="true"></i>
        <h2 class="h4 fw-semibold mt-3">No orders yet</h2>
        <p class="text-secondary mb-4">Your orders will appear here after you place one.</p>
        <a class="btn btn-primary" href="/">Start shopping</a>
      </div>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
