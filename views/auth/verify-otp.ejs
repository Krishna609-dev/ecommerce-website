<%- include('../partials/header', { title: 'Verify your email' }) %>
<%- include('../partials/flash') %>

<section class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
      <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">
          <h1 class="h3 text-center fw-bold mb-3">Verify your email</h1>
          <p class="text-center text-secondary mb-4">
            We sent a 6-digit code to<br>
            <strong class="text-body"><%= email %></strong>
          </p>

          <% if (errors.length) { %>
            <div class="alert alert-danger" role="alert" aria-labelledby="otpErrorsTitle">
              <h2 class="h6 alert-heading" id="otpErrorsTitle">We couldn't verify that code:</h2>
              <ul class="mb-0">
                <% errors.forEach(function(item) { %>
                  <li><%= item.msg %></li>
                <% }) %>
              </ul>
            </div>
          <% } %>

          <div class="text-center mb-3" aria-live="polite">
            <span class="small text-secondary">Code expires in </span>
            <strong id="otpCountdown">10:00</strong>
          </div>

          <form action="/verify-otp" method="POST" id="verifyOtpForm">
            <input type="hidden" name="email" value="<%= email %>">
            <input type="hidden" name="otp" id="otpValue" required>

            <fieldset class="mb-4">
              <legend class="visually-hidden">Enter the 6-digit verification code</legend>
              <div class="d-flex justify-content-center gap-2 gap-sm-3" role="group" aria-label="6-digit verification code">
                <% for (let digit = 0; digit < 6; digit++) { %>
                  <input
                    class="form-control text-center fw-semibold"
                    style="width: 3rem; height: 3.5rem; font-size: 1.25rem;"
                    type="text"
                    inputmode="numeric"
                    pattern="[0-9]"
                    maxlength="1"
                    aria-label="Digit <%= digit + 1 %> of 6"
                    autocomplete="<%= digit === 0 ? 'one-time-code' : 'off' %>"
                    data-otp-digit
                    required>
                <% } %>
              </div>
            </fieldset>

            <button class="btn btn-primary w-100" type="submit">Verify email</button>
          </form>

          <div class="text-center mt-4">
            <form action="/resend-otp" method="POST" id="resendOtpForm">
              <input type="hidden" name="email" value="<%= email %>">
              <button class="btn btn-link p-0" id="resendOtpButton" type="submit" disabled>
                Resend OTP <span class="text-secondary">(<span id="resendCountdown">30</span>s)</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var digitInputs = Array.from(document.querySelectorAll('[data-otp-digit]'));
    var otpValue = document.getElementById('otpValue');
    var verifyForm = document.getElementById('verifyOtpForm');
    var countdown = document.getElementById('otpCountdown');
    var resendCountdown = document.getElementById('resendCountdown');
    var resendButton = document.getElementById('resendOtpButton');
    var remainingSeconds = 10 * 60;
    var remainingResendSeconds = 30;

    function updateOtpValue() {
      otpValue.value = digitInputs.map(function (input) {
        return input.value;
      }).join('');
    }

    digitInputs.forEach(function (input, index) {
      input.addEventListener('input', function () {
        input.value = input.value.replace(/\D/g, '').slice(-1);
        updateOtpValue();

        if (input.value && index < digitInputs.length - 1) {
          digitInputs[index + 1].focus();
        }
      });

      input.addEventListener('keydown', function (event) {
        if (event.key === 'Backspace' && !input.value && index > 0) {
          digitInputs[index - 1].focus();
        } else if (event.key === 'ArrowLeft' && index > 0) {
          digitInputs[index - 1].focus();
        } else if (event.key === 'ArrowRight' && index < digitInputs.length - 1) {
          digitInputs[index + 1].focus();
        }
      });

      input.addEventListener('paste', function (event) {
        var pastedCode = event.clipboardData.getData('text').replace(/\D/g, '').slice(0, 6);
        if (!pastedCode) {
          return;
        }

        event.preventDefault();
        pastedCode.split('').forEach(function (digit, pastedIndex) {
          digitInputs[pastedIndex].value = digit;
        });
        updateOtpValue();
        digitInputs[Math.min(pastedCode.length, digitInputs.length - 1)].focus();
      });
    });

    verifyForm.addEventListener('submit', function (event) {
      updateOtpValue();
      if (otpValue.value.length !== 6) {
        event.preventDefault();
        digitInputs.find(function (input) {
          return !input.value;
        }).focus();
      }
    });

    window.setInterval(function () {
      if (remainingSeconds > 0) {
        remainingSeconds -= 1;
      }
      countdown.textContent = String(Math.floor(remainingSeconds / 60)).padStart(2, '0') +
        ':' + String(remainingSeconds % 60).padStart(2, '0');

      if (remainingResendSeconds > 0) {
        remainingResendSeconds -= 1;
        resendCountdown.textContent = remainingResendSeconds;
        if (remainingResendSeconds === 0) {
          resendButton.disabled = false;
          resendButton.querySelector('.text-secondary').textContent = '';
        }
      }
    }, 1000);
  })();
</script>

<%- include('../partials/footer') %>
