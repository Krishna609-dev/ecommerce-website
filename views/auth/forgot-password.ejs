<%- include('../partials/header', { title: 'Forgot password' }) %>
<%- include('../partials/flash') %>

<section class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
      <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">
          <h1 class="h3 text-center fw-bold mb-3">Forgot password?</h1>
          <p class="text-center text-secondary mb-4">Enter your email and we'll send you a code to reset your password.</p>

          <% if (errors.length) { %>
            <div class="alert alert-danger" role="alert" aria-labelledby="forgotPasswordErrorsTitle">
              <h2 class="h6 alert-heading" id="forgotPasswordErrorsTitle">Please fix the following:</h2>
              <ul class="mb-0">
                <% errors.forEach(function(item) { %>
                  <li><%= item.msg %></li>
                <% }) %>
              </ul>
            </div>
          <% } %>

          <form action="/forgot-password" method="POST">
            <div class="mb-4">
              <label class="form-label" for="email">Email</label>
              <input class="form-control" id="email" name="email" type="email" autocomplete="email" required>
            </div>
            <button class="btn btn-primary w-100" type="submit">Send OTP</button>
          </form>

          <p class="text-center mt-4 mb-0">
            <a href="/login">Back to login</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
